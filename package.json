{
  "name": "tecmotiv-erp",
  "version": "4.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x <=24.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "deploy:prod": "vercel build --prod && node scripts/patch-vercel-shims.js && vercel deploy --prebuilt --prod"
  }
}
